# Local Docker Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=biosciences-deepagents
LANGSMITH_API_KEY=your-langsmith-api-key

# REQUIRED: FastMCP Cloud auth for https://biosciences-mcp.fastmcp.app/mcp
# Sent as Authorization: Bearer <key> on every MCP HTTP request
BIOSCIENCES_API_KEY=your-biosciences-api-key-here

# =============================================================================
# MCP Endpoint URLs
# =============================================================================
# BIOSCIENCES_MCP_URL: FastMCP Cloud endpoint — DO NOT change to localhost.
# This repo always uses the cloud-hosted biosciences-mcp server.
# There is no local biosciences-mcp instance for deepagents to connect to.
# Requires BIOSCIENCES_API_KEY (above) to authenticate.
BIOSCIENCES_MCP_URL=https://biosciences-mcp.fastmcp.app/mcp

# GRAPHITI_MCP_URL: Local Graphiti knowledge graph server — a completely
# separate service from biosciences-mcp. Run via Docker using the
# biosciences-memory repo. localhost:8000 is correct here.
GRAPHITI_MCP_URL=http://localhost:8000/mcp

# DOCS_MCP_URL: LangChain documentation MCP (rarely needs changing).
DOCS_MCP_URL=https://docs.langchain.com/mcp

OPENAI_API_KEY=your-openai-api_key
GOOGLE_API_KEY=your-google-api_key
ANTHROPIC_API_KEY=your-anthropic-api_key